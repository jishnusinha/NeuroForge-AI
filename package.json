{
  "name": "neuroforge-ai",
  "version": "1.0.0",
  "description": "NeuroForge AI - Interactive Machine Learning & Deep Learning Laboratory",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/mongo.integration.mjs",
    "test:e2e": "npm run build:client && playwright test",
    "test:e2e:memory": "npm run build:client && node scripts/run-browser-tests.mjs memory",
    "baseline:summary": "node scripts/summarize-verification.mjs",
    "lint": "npm --prefix client run lint -- --deny-warnings",
    "check": "npm test && npm run lint && npm run test:integration && npm run test:e2e",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server start"
  },
  "keywords": [
    "machine-learning",
    "deep-learning",
    "interactive-lab",
    "tensorflow-js",
    "react",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
